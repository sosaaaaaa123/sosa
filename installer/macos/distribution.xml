<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Sosa Tune</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="clap"/>
    </choices-outline>
    <choice id="vst3" title="Sosa Tune VST3" description="Per Pro Tools (tramite Blue Cat PatchWork), FL Studio, Ableton Live, Cubase, Studio One, Reaper e gli altri DAW VST3." start_selected="true">
        <pkg-ref id="com.vladislav.sosatune.vst3"/>
    </choice>
    <choice id="clap" title="Sosa Tune CLAP" description="Per Bitwig, Reaper e gli altri DAW che usano il formato CLAP." start_selected="true">
        <pkg-ref id="com.vladislav.sosatune.clap"/>
    </choice>
    <pkg-ref id="com.vladislav.sosatune.vst3" version="@VERSION@" onConclusion="none">SosaTune-vst3.pkg</pkg-ref>
    <pkg-ref id="com.vladislav.sosatune.clap" version="@VERSION@" onConclusion="none">SosaTune-clap.pkg</pkg-ref>
</installer-gui-script>
