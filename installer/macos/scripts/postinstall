#!/bin/bash
# Dopo l'installazione: toglie la quarantena dai plugin e rimuove eventuali
# copie vecchie nella cartella utente (due copie confondono i DAW).
for dir in "/Library/Audio/Plug-Ins/VST3/SosaTune.vst3" "/Library/Audio/Plug-Ins/CLAP/SosaTune.clap"; do
  if [ -e "$dir" ]; then
    xattr -dr com.apple.quarantine "$dir" 2>/dev/null || true
    chmod -R a+rX "$dir" 2>/dev/null || true
  fi
done
user=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -n "$user" ] && [ "$user" != "root" ]; then
  home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  if [ -n "$home" ]; then
    rm -rf "$home/Library/Audio/Plug-Ins/VST3/SosaTune.vst3" "$home/Library/Audio/Plug-Ins/CLAP/SosaTune.clap" 2>/dev/null || true
  fi
fi
exit 0
