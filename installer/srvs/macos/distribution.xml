<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>SR Vocal Suite</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="clap"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="SR Vocal Suite VST3" description="Per Pro Tools (tramite Blue Cat PatchWork), FL Studio, Ableton Live, Cubase, Studio One, Reaper e gli altri DAW VST3." start_selected="true">
        <pkg-ref id="com.vladislav.srvocalsuite.vst3"/>
    </choice>
    <choice id="clap" title="SR Vocal Suite CLAP" description="Per Bitwig, Reaper e gli altri DAW che usano il formato CLAP." start_selected="false">
        <pkg-ref id="com.vladislav.srvocalsuite.clap"/>
    </choice>
    <choice id="au" title="SR Vocal Suite Audio Unit" description="Per Logic Pro, GarageBand, MainStage e gli altri programmi Apple (formato Audio Unit)." start_selected="false">
        <pkg-ref id="com.vladislav.srvocalsuite.component"/>
    </choice>
    <pkg-ref id="com.vladislav.srvocalsuite.component" version="@VERSION@" onConclusion="none">SRVocalSuite-component.pkg</pkg-ref>
    <pkg-ref id="com.vladislav.srvocalsuite.vst3" version="@VERSION@" onConclusion="none">SRVocalSuite-vst3.pkg</pkg-ref>
    <pkg-ref id="com.vladislav.srvocalsuite.clap" version="@VERSION@" onConclusion="none">SRVocalSuite-clap.pkg</pkg-ref>
</installer-gui-script>
